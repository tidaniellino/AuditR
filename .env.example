NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente para Edge Functions / rotas server-side (nunca expor no client)
SUPABASE_SERVICE_ROLE_KEY=

# URL canônica do app (sem barra no final), usada só no servidor para montar
# links enviados por e-mail/WhatsApp (redefinição de senha, assinatura de
# contrato, checkout do Stripe). Sem prefixo NEXT_PUBLIC_ de propósito — nunca
# é lida no client. Obrigatório em produção — NÃO deduzir do header Host da
# requisição, que pode ser forjado pelo cliente. Em preview deployments da
# Vercel pode ficar vazio (usa VERCEL_URL automaticamente).
APP_URL=https://auditr.com.br

# Integrações
RECEITA_FEDERAL_API_KEY=
SIGNATURE_PROVIDER_API_KEY=

# WhatsApp Business Cloud API (Meta) — envio do código de assinatura por
# WhatsApp além do e-mail. Token e Phone Number ID vêm do Meta Business
# Manager (App do WhatsApp Business). O template abaixo precisa estar
# pré-aprovado no Meta: corpo com 3 variáveis (nome do cliente, título do
# contrato, código) + botão de URL dinâmica com sufixo "assinar/{id}".
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_TEMPLATE_SIGNING_NAME=contrato_assinatura

# Stripe — assinatura paga do SaaS (Plano Profissional/Plano Corporativo).
# Secret Key em Developers → API keys; Webhook Secret em Developers →
# Webhooks (endpoint apontando para /api/stripe/webhook, eventos
# checkout.session.completed, customer.subscription.created,
# customer.subscription.updated e customer.subscription.deleted); os 2 Price
# IDs vêm dos Produtos recorrentes criados em Product catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_CORPORATIVO=
